# Operating system
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example

# Raw and large data are tracked through manifests, not Git
data/raw/**
data/staging/**
data/canonical/**
data/releases/**
data/web/**
!data/raw/.gitkeep
!data/staging/.gitkeep
!data/canonical/.gitkeep
!data/releases/.gitkeep

# Common large analytical artifacts
audit_packages/
artifacts/public_releases/
backups/
*.parquet
*.feather
*.duckdb
*.db
*.sqlite
*.gpkg
*.shp
*.shx
*.dbf
*.tif
*.tiff
*.zip
*.7z
*.gz

# Explicitly version the immutable public release used by the Vercel web bundle.
!web/public/releases/
!web/public/releases/MDB_OPEN_DATA_2024_1/
!web/public/releases/MDB_OPEN_DATA_2024_1/**

# Provider state, credentials, certificates, dumps, and browser outputs.
.vercel/
.supabase/
supabase/.temp/
*.dump
*.backup
*.pem
*.key
*.p12
*.pfx
playwright-report/
test-results/
web/playwright-report/
web/test-results/

# Keep source and release metadata versioned
!metadata/**/*.yaml
!metadata/**/*.yml
!metadata/**/*.md
.vercel
