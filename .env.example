# No secrets are required for the repository foundation.
# Add local paths only when raw source acquisition is explicitly authorized.

MDB_DATA_ROOT=./data
MDB_RELEASE_ID=MDB_ANALYTICAL_2024_1
MDB_METHOD_VERSION=MDB_METHOD_1.0
MDB_GEOGRAPHY_VERSION=BR_HEALTH_REGIONS_END2024_V1

# Local PostgreSQL/PostGIS serving database.
MDB_DB_HOST=127.0.0.1
MDB_DB_PORT=5432
MDB_DB_NAME=mente_do_brasil
MDB_DB_USER=mente_do_brasil
MDB_DB_PASSWORD=SET_A_LOCAL_PASSWORD

# Local read-only API.
MDB_DEFAULT_RELEASE_ID=MDB_ANALYTICAL_2024_1
MDB_API_HOST=127.0.0.1
MDB_API_PORT=8000
MDB_API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MDB_API_DB_USER=mente_do_brasil_api
MDB_API_DB_PASSWORD=SET_A_LOCAL_API_PASSWORD
